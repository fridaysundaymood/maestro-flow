{
  "name": "@budaknyenyel/maestro-flow",
  "version": "0.1.0",
  "description": "Generate, lint and run Maestro flows with Android resource and device evidence",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/fridaysundaymood/maestro-flow.git" },
  "homepage": "https://github.com/fridaysundaymood/maestro-flow#readme",
  "bugs": { "url": "https://github.com/fridaysundaymood/maestro-flow/issues" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "maestro-flow": "./dist/cli/index.js",
    "maestro-flow-mcp": "./dist/mcp/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skill",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run",
    "prepare-publish": "node scripts/prepare-publish.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@budaknyenyel/emu-lab": "file:../emu-lab",
    "@budaknyenyel/kit-schema": "file:../android-kit/packages/kit-schema",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "ajv": "^8.17.1",
    "fast-xml-parser": "^5.3.0",
    "yaml": "^2.8.1",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
